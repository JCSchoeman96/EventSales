<Layouts.flash_group flash={@flash} />

<main class="min-h-screen bg-base-200 px-4 py-16 sm:px-6 lg:px-8">
  <section class="mx-auto max-w-md">
    <div class="card border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body">
        <div class="badge badge-primary badge-outline">Internal Admin</div>
        <h1 class="card-title text-2xl">Admin sign in</h1>
        <p class="text-sm leading-6 text-base-content/70">
          Sign in with an approved EventSales admin account.
        </p>

        <form action={~p"/admin/login"} method="post" class="mt-4 grid gap-4">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

          <label class="form-control">
            <span class="label">
              <span class="label-text">Email</span>
            </span>
            <input
              type="email"
              name="admin_session[email]"
              value={@email}
              autocomplete="username"
              class="input input-bordered"
              required
            />
          </label>

          <label class="form-control">
            <span class="label">
              <span class="label-text">Password</span>
            </span>
            <input
              type="password"
              name="admin_session[password]"
              autocomplete="current-password"
              class="input input-bordered"
              required
            />
          </label>

          <button type="submit" class="btn btn-primary">Sign in</button>
        </form>

        <div class="divider"></div>

        <div class="flex flex-wrap gap-2">
          <.link href={~p"/"} class="btn btn-ghost btn-sm">EventSales home</.link>
          <.link href={~p"/health"} class="btn btn-ghost btn-sm">Health</.link>
        </div>
      </div>
    </div>
  </section>
</main>
