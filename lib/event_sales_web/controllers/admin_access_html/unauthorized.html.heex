<main class="min-h-screen bg-base-200 px-4 py-16 sm:px-6 lg:px-8">
  <section class="mx-auto max-w-2xl">
    <div class="card border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body">
        <div class="badge badge-warning">401</div>
        <h1 class="card-title text-2xl">Admin access required</h1>
        <p class="text-sm leading-6 text-base-content/70">
          EventSales is an internal admin tool. Sign in with an approved admin account before
          opening operational sales dashboards.
        </p>
        <div class="card-actions mt-4">
          <.link href={~p"/"} class="btn btn-primary">EventSales home</.link>
          <.link href={~p"/health"} class="btn btn-outline">Health</.link>
        </div>
      </div>
    </div>
  </section>
</main>
