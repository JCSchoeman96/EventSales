<Layouts.flash_group flash={@flash} />

<main class="min-h-screen bg-base-200 px-4 py-12 sm:px-6 lg:px-8">
  <section class="mx-auto flex max-w-5xl flex-col gap-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="badge badge-primary badge-outline">Internal Admin</div>
        <h1 class="mt-4 text-3xl font-semibold text-base-content">EventSales</h1>
        <p class="mt-2 max-w-2xl text-base leading-7 text-base-content/70">
          Internal sales intelligence for WooCommerce and Tickera. This service ingests ticket
          sales, stores durable operational truth, and serves admin dashboards for approved staff.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <.link href={~p"/health"} class="btn btn-outline">Health</.link>
        <.link :if={@admin_session?} href={~p"/admin/dashboard"} class="btn btn-primary">
          Admin dashboard
        </.link>
      </div>
    </div>

    <section class="grid gap-4 md:grid-cols-3">
      <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <h2 class="card-title text-base">Purpose</h2>
          <p class="text-sm leading-6 text-base-content/70">
            Flash-sale-safe admin visibility backed by EventSales aggregates and local read models.
          </p>
        </div>
      </div>
      <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <h2 class="card-title text-base">Access</h2>
          <p class="text-sm leading-6 text-base-content/70">
            Admin routes require an authenticated account with the global admin role.
          </p>
        </div>
      </div>
      <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <h2 class="card-title text-base">Status</h2>
          <p class="text-sm leading-6 text-base-content/70">
            Use the health endpoint for deployment and uptime checks.
          </p>
        </div>
      </div>
    </section>
  </section>
</main>
