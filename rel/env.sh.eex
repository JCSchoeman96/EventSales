#!/bin/sh

if [ -n "${EVENTSALES_NODE_IP:-}" ]; then
  if [ -z "${RELEASE_COOKIE:-}" ]; then
    printf '%s\n' 'RELEASE_COOKIE must be set when EVENTSALES_NODE_IP is set.' >&2
    exit 1
  fi

  ipv4_remaining=$EVENTSALES_NODE_IP
  ipv4_count=0
  ipv4_tuple=

  while :; do
    case "$ipv4_remaining" in
      *.*)
        ipv4_octet=${ipv4_remaining%%.*}
        ipv4_remaining=${ipv4_remaining#*.}
        ipv4_has_more=yes
        ;;
      *)
        ipv4_octet=$ipv4_remaining
        ipv4_remaining=
        ipv4_has_more=no
        ;;
    esac

    case "$ipv4_octet" in
      0|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;;
      *)
        printf '%s\n' 'EVENTSALES_NODE_IP must be a valid IPv4 address.' >&2
        exit 1
        ;;
    esac

    if [ "$ipv4_octet" -gt 255 ]; then
      printf '%s\n' 'EVENTSALES_NODE_IP must be a valid IPv4 address.' >&2
      exit 1
    fi

    ipv4_count=$((ipv4_count + 1))

    if [ "$ipv4_count" -gt 4 ]; then
      printf '%s\n' 'EVENTSALES_NODE_IP must be a valid IPv4 address.' >&2
      exit 1
    fi

    if [ -n "$ipv4_tuple" ]; then
      ipv4_tuple="$ipv4_tuple,$ipv4_octet"
    else
      ipv4_tuple=$ipv4_octet
    fi

    if [ "$ipv4_has_more" = no ]; then
      break
    fi
  done

  if [ "$ipv4_count" -ne 4 ]; then
    printf '%s\n' 'EVENTSALES_NODE_IP must be a valid IPv4 address.' >&2
    exit 1
  fi

  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="event_sales@${EVENTSALES_NODE_IP}"
  export ERL_EPMD_ADDRESS="$EVENTSALES_NODE_IP"

  case "${RELEASE_COMMAND:-}" in
    start*|daemon*|rpc|remote|restart|stop|pid)
      if [ -n "${ELIXIR_ERL_OPTIONS:-}" ]; then
        ELIXIR_ERL_OPTIONS="$ELIXIR_ERL_OPTIONS -kernel inet_dist_use_interface {$ipv4_tuple}"
      else
        ELIXIR_ERL_OPTIONS="-kernel inet_dist_use_interface {$ipv4_tuple}"
      fi
      export ELIXIR_ERL_OPTIONS
      ;;
  esac
fi
