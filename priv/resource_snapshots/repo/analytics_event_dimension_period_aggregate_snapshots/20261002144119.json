    },
    {
      "attribute": [
        "refund_ticket_value"
      ],
      "base_filter": null,
      "check": "refund_ticket_value >= 0",
      "name": "analytics_dim_period_refund_value_check"
    },
    {
      "attribute": [
        "woo_product_id"
      ],
      "base_filter": null,
      "check": "woo_product_id IS NULL OR woo_product_id > 0",
