path_has_symlink_component() {
  local path=$1 current='' component
  local -a components=()
  IFS=/ read -r -a components <<<"${path#/}"
  for component in "${components[@]}"; do
    [[ -n "$component" ]] || continue
    current+="/$component"
    [[ ! -L "$current" ]] || return 0
  done
  return 1
}

directory_metadata_matches() {
  local path=$1 uid=$2 gid=$3 expected_mode=$4 metadata
  [[ ! -L "$path" && -d "$path" ]] || return 1
  metadata=$(stat -c '%u:%g:%a' -- "$path" 2>/dev/null) || return 1
  [[ "$metadata" == "$uid:$gid:$expected_mode" ]]
}

file_metadata_matches() {
  local path=$1 uid=$2 gid=$3 expected_mode=$4 metadata
  [[ ! -L "$path" && -f "$path" ]] || return 1
  metadata=$(stat -c '%u:%g:%a:%h' -- "$path" 2>/dev/null) || return 1
  [[ "$metadata" == "$uid:$gid:$expected_mode:1" ]]
}

validate_tree() {
  local tree_root=$1 manifest_name=$2 owner_uid=$3 owner_gid=$4 directory_mode=$5 file_mode=$6
  local -n manifest_ref=$manifest_name
  local entry git_mode expected_blob relative_path path actual_blob expected_file_mode root_device entry_device
  local found_path

  path_has_symlink_component "$tree_root" && return 1
  directory_metadata_matches "$tree_root" "$owner_uid" "$owner_gid" "$directory_mode" || return 1
  root_device=$(stat -c '%d' -- "$tree_root" 2>/dev/null) || return 1

  for relative_path in "${EXPECTED_DIRS[@]}"; do
    path="$tree_root/$relative_path"
    path_has_symlink_component "$path" && return 1
    directory_metadata_matches "$path" "$owner_uid" "$owner_gid" "$directory_mode" || return 1
    entry_device=$(stat -c '%d' -- "$path" 2>/dev/null) || return 1
    [[ "$entry_device" == "$root_device" ]] || return 1
  done

  for entry in "${manifest_ref[@]}"; do
    read -r git_mode expected_blob relative_path <<<"$entry"
    [[ "$git_mode" == 100644 || "$git_mode" == 100755 ]] || return 1
    [[ "$expected_blob" =~ ^[0-9a-f]{40}$ ]] || return 1
    path="$tree_root/$relative_path"
    path_has_symlink_component "$path" && return 1
    if [[ "$file_mode" == candidate ]]; then
      expected_file_mode=600
    elif [[ "$git_mode" == 100755 ]]; then
      expected_file_mode=555
    else
      expected_file_mode=444
    fi
    file_metadata_matches "$path" "$owner_uid" "$owner_gid" "$expected_file_mode" || return 1
    entry_device=$(stat -c '%d' -- "$path" 2>/dev/null) || return 1
    [[ "$entry_device" == "$root_device" ]] || return 1
    actual_blob=$(git hash-object --no-filters -- "$path" 2>/dev/null) || return 1
    [[ "$actual_blob" == "$expected_blob" ]] || return 1
  done

  while IFS= read -r -d '' found_path; do
    [[ "$found_path" == "$tree_root/"* ]] || return 1
    relative_path=${found_path#"$tree_root"/}
    if [[ -L "$found_path" ]]; then return 1; fi
    if [[ -d "$found_path" ]]; then
      case "$relative_path" in
        pgbouncer-image|scripts|templates) ;;
        *) return 1 ;;
      esac
    elif [[ -f "$found_path" ]]; then
      case "$relative_path" in
        compose.yaml|README.md|pgbouncer-image/Dockerfile|pgbouncer-image/eventsales_pgbouncer_healthcheck.rs|pgbouncer-image/prove-image.sh|scripts/bootstrap-postgres.sh|scripts/generate-secrets.sh|scripts/probe-pgbouncer.sh|scripts/probe-postgres.sh|scripts/probe-redis.sh|scripts/provision-networks.sh|scripts/render-runtime-config.sh|templates/pgbouncer.ini.template|templates/redis-users.acl.template) ;;
        *) return 1 ;;
      esac
    else
      return 1
    fi
  done < <(find "$tree_root" -mindepth 1 -print0 2>/dev/null) || return 1
}

candidate_handoff() {
  local action=$1 destination=${2:-}
  python3 -I - "$action" "$CANDIDATE_DIR" "$destination" "$agent_uid" "$agent_gid" \
    "$ROOT_UID" "$ROOT_GID" "${EXPECTED_DIRS[@]}" -- "${SOURCE_MANIFEST[@]}" <<'PY'
import hashlib
import os
import stat
import sys

MAX_FILE_BYTES = 1048576
DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
SOURCE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC


def fail():
    raise ValueError("candidate handoff rejected")


def open_directory_at(parent_fd, name):
    return os.open(name, DIRECTORY_FLAGS, dir_fd=parent_fd)


def open_absolute_directory(path):
    if not path.startswith("/"):
        fail()
    fd = os.open("/", DIRECTORY_FLAGS)
    try:
        for component in path.split("/")[1:]:
            if not component or component in (".", ".."):
                fail()
            next_fd = open_directory_at(fd, component)
            os.close(fd)
            fd = next_fd
        return fd
    except Exception:
        os.close(fd)
        raise


def check_directory(fd, uid, gid, mode, device=None):
    info = os.fstat(fd)
    if not stat.S_ISDIR(info.st_mode):
        fail()
    if (info.st_uid, info.st_gid, stat.S_IMODE(info.st_mode)) != (uid, gid, mode):
        fail()
    if device is not None and info.st_dev != device:
        fail()
    return info


def write_all(fd, data):
    view = memoryview(data)
    while view:
        written = os.write(fd, view)
        if written <= 0:
            fail()
        view = view[written:]


def main():
    args = sys.argv[1:]
    if len(args) < 8:
        fail()
    action, candidate_path, destination, uid_text, gid_text, root_uid_text, root_gid_text = args[:7]
    separator = args.index("--", 7)
    expected_dirs = args[7:separator]
    uid, gid = int(uid_text), int(gid_text)
    root_uid, root_gid = int(root_uid_text), int(root_gid_text)
    if action not in ("validate", "snapshot") or not expected_dirs:
        fail()

    manifest = []
    files_by_directory = {"": set(), **{directory: set() for directory in expected_dirs}}
    for entry in args[separator + 1:]:
        mode_text, blob, relative_path = entry.split(" ", 2)
        parts = relative_path.split("/")
        if len(parts) == 1:
            directory, name = "", parts[0]
        elif len(parts) == 2 and parts[0] in expected_dirs:
            directory, name = parts
        else:
            fail()
        if mode_text not in ("100644", "100755") or len(blob) != 40:
            fail()
        if any(character not in "0123456789abcdef" for character in blob):
            fail()
        if not name or name in (".", "..") or name in files_by_directory[directory]:
            fail()
        files_by_directory[directory].add(name)
        manifest.append((mode_text, blob, directory, name))
    if not manifest or any(not files_by_directory[directory] for directory in expected_dirs):
        fail()

    candidate_name = os.path.basename(candidate_path)
    candidate_parent_path = os.path.dirname(candidate_path)
    parent_fd = open_absolute_directory(candidate_parent_path)
    root_fd = -1
    destination_fd = -1
    try:
        parent_info = check_directory(parent_fd, uid, gid, 0o700)
        root_fd = open_directory_at(parent_fd, candidate_name)
        root_info = check_directory(root_fd, uid, gid, 0o700, parent_info.st_dev)
        expected_root_entries = files_by_directory[""] | set(expected_dirs)
        if set(os.listdir(root_fd)) != expected_root_entries:
            fail()

        source_directory_fds = {"": root_fd}
        for directory in expected_dirs:
            directory_fd = open_directory_at(root_fd, directory)
            check_directory(directory_fd, uid, gid, 0o700, root_info.st_dev)
            expected_names = sorted(files_by_directory[directory])
            if sorted(os.listdir(directory_fd)) != expected_names:
                os.close(directory_fd)
                fail()
            source_directory_fds[directory] = directory_fd

        destination_directory_fds = {}
        if action == "snapshot":
            destination_fd = open_absolute_directory(destination)
            destination_info = check_directory(destination_fd, root_uid, root_gid, 0o700)
            if set(os.listdir(destination_fd)) != set(expected_dirs):
                fail()
            destination_directory_fds[""] = destination_fd
            for directory in expected_dirs:
                directory_fd = open_directory_at(destination_fd, directory)
                check_directory(directory_fd, root_uid, root_gid, 0o700, destination_info.st_dev)
                if os.listdir(directory_fd):
                    os.close(directory_fd)
                    fail()
                destination_directory_fds[directory] = directory_fd

        for mode_text, expected_blob, directory, name in manifest:
            source_fd = os.open(name, SOURCE_FLAGS, dir_fd=source_directory_fds[directory])
            output_fd = -1
            try:
                info = os.fstat(source_fd)
                if not stat.S_ISREG(info.st_mode):
                    fail()
                if (info.st_uid, info.st_gid, stat.S_IMODE(info.st_mode), info.st_nlink) != (uid, gid, 0o600, 1):
                    fail()
                if info.st_dev != root_info.st_dev or info.st_size > MAX_FILE_BYTES:
                    fail()
                if action == "snapshot":
                    output_fd = os.open(
                        name,
                        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                        0o600,
                        dir_fd=destination_directory_fds[directory],
                    )
                    os.fchown(output_fd, root_uid, root_gid)
                    os.fchmod(output_fd, 0o600)

                digest = hashlib.sha1()
                digest.update(("blob %d\0" % info.st_size).encode("ascii"))
                total = 0
                while True:
                    if total == MAX_FILE_BYTES:
                        chunk = os.read(source_fd, 1)
                        if chunk:
                            fail()
                        break
                    chunk = os.read(source_fd, min(65536, MAX_FILE_BYTES - total))
                    if not chunk:
                        break
                    total += len(chunk)
                    if output_fd >= 0:
                        write_all(output_fd, chunk)
                    digest.update(chunk)
                if total != info.st_size or digest.hexdigest() != expected_blob:
                    fail()
            finally:
                os.close(source_fd)
                if output_fd >= 0:
                    os.close(output_fd)

        for directory, fd in source_directory_fds.items():
            if directory:
                os.close(fd)
        for directory, fd in destination_directory_fds.items():
            if directory:
                os.close(fd)
    finally:
        if destination_fd >= 0:
            os.close(destination_fd)
        if root_fd >= 0:
            os.close(root_fd)
        os.close(parent_fd)


try:
    main()
except Exception:
    sys.exit(1)
PY
}

require_root_directory() {
  local path=$1 mode_check=$2 metadata owner group mode mode_value
  path_has_symlink_component "$path" && return 1
  [[ -d "$path" && ! -L "$path" ]] || return 1
  metadata=$(stat -c '%u:%g:%a' -- "$path" 2>/dev/null) || return 1
  IFS=: read -r owner group mode <<<"$metadata"
  [[ "$owner" == "$ROOT_UID" && "$group" == "$ROOT_GID" ]] || return 1
  if [[ "$mode_check" == protected ]]; then
    mode_value=$((8#$mode))
    (( (mode_value & 0022) == 0 )) || return 1
  fi
}

require_marker() {
  local path=$1
  path_has_symlink_component "$path" && return 1
  directory_metadata_matches "$path" "$ROOT_UID" "$ROOT_GID" 700
}

preflight() {
  require_root_directory /root protected || { PREFLIGHT_REASON=ROOT_DIRECTORY_INVALID; return 1; }
  require_root_directory "$PROD_ROOT" protected || { PREFLIGHT_REASON=PRODUCTION_ROOT_INVALID; return 1; }
  require_root_directory "$STAGED_ROOT" protected || { PREFLIGHT_REASON=STAGED_ROOT_INVALID; return 1; }

  candidate_handoff validate \
    || { PREFLIGHT_REASON=CANDIDATE_MANIFEST_INVALID; return 1; }

  require_root_directory "$C9CE_COMMIT_DIR" immutable \
    || { PREFLIGHT_REASON=C9CE_COMMIT_DIRECTORY_INVALID; return 1; }
  directory_metadata_matches "$C9CE_COMMIT_DIR" "$ROOT_UID" "$ROOT_GID" 555 \
    || { PREFLIGHT_REASON=C9CE_COMMIT_METADATA_INVALID; return 1; }
  validate_tree "$C9CE_DATA_PLANE_DIR" C9CE_MANIFEST "$ROOT_UID" "$ROOT_GID" 555 immutable \
    || { PREFLIGHT_REASON=C9CE_STAGE_DRIFT; return 1; }

  require_marker "$V4_MARKER" || { PREFLIGHT_REASON=V4_MARKER_INVALID; return 1; }
  [[ ! -e "$V5_STAGE_MARKER" && ! -L "$V5_STAGE_MARKER" ]] \
    || { PREFLIGHT_REASON=V5_STAGE_MARKER_ALREADY_CONSUMED; return 1; }
  [[ ! -e "$TARGET_COMMIT_DIR" && ! -L "$TARGET_COMMIT_DIR" ]] \
    || { PREFLIGHT_REASON=TARGET_PATH_ALREADY_EXISTS; return 1; }
  [[ ! -e "$TEMP_STAGE_DIR" && ! -L "$TEMP_STAGE_DIR" ]] \
    || { PREFLIGHT_REASON=TEMP_STAGE_PATH_ALREADY_EXISTS; return 1; }
  return 0
}

preflight || preflight_blocked "$PREFLIGHT_REASON"
preflight || preflight_blocked "SECOND_REVALIDATION_$PREFLIGHT_REASON"

mkdir -m 0700 -- "$V5_STAGE_MARKER" 2>/dev/null || preflight_blocked V5_MARKER_CREATE_FAILED
directory_metadata_matches "$V5_STAGE_MARKER" "$ROOT_UID" "$ROOT_GID" 700 \
