#!/bin/bash -p
set -euo pipefail
set +x
umask 077
IFS=$' \t\n'

readonly SAFE_PATH='/usr/sbin:/usr/bin:/sbin:/bin'
readonly DOCKER_SOCKET='unix:///var/run/docker.sock'
readonly ROOT_UID='0'
readonly ROOT_GID='0'
readonly OLD_SOURCE_SHA='2f69c126ab0098ed2d1323ed33d6bc2761df752f'
readonly OLD_STAGE="/root/eventsales-prod/staged/$OLD_SOURCE_SHA/data-plane"
readonly OLD_COMPOSE="$OLD_STAGE/compose.yaml"
readonly EXPECTED_COMPOSE_SHA256='f8d2cee51d6647d7026324ffee8a6ebf82cf8ea7e7a3ed6ca82626cf67b5819f'
readonly NEW_SOURCE_SHA='c9ce0f9239123a6e58f66fde0b5a1e60238bb107'
readonly NEW_SOURCE_DIR="/root/eventsales-prod/staged/$NEW_SOURCE_SHA"
readonly NEW_STAGE="$NEW_SOURCE_DIR/data-plane"
readonly POSTGRES_CONTAINER='eventsales-prod-postgres-1'
readonly POSTGRES_VOLUME='eventsales-prod_postgres_data'
readonly DATA_NETWORK='eventsales-prod_eventsales_data'
readonly EDGE_NETWORK='eventsales-prod_eventsales_edge'
readonly POSTGRES_IMAGE='dhi.io/postgres:18.6-alpine3.24@sha256:d33bd884995daddfb515d0ce9aec23b74d20d72e03ca42b72c4abf617c76bb19'
readonly POSTGRES_COMMAND='postgres,-c,max_connections=100,-c,shared_buffers=768MB,-c,effective_cache_size=2GB,-c,work_mem=8MB,-c,maintenance_work_mem=256MB,'
readonly POSTGRES_MOUNT='volume:eventsales-prod_postgres_data:/var/lib/postgresql,'
readonly POSTGRES_NETWORK="${DATA_NETWORK},"
# Docker consumes these literal Go-template expressions at runtime.
# shellcheck disable=SC2016
readonly POSTGRES_FORMAT='{{.State.Status}}|{{.State.Running}}|{{.State.Restarting}}|{{.State.ExitCode}}|{{.RestartCount}}|{{.State.OOMKilled}}|{{.Config.Image}}|{{range .Config.Cmd}}{{printf "%s," .}}{{end}}|{{range .Mounts}}{{printf "%s:%s:%s," .Type .Name .Destination}}{{end}}|{{range $name, $_ := .NetworkSettings.Networks}}{{printf "%s," $name}}{{end}}|{{if .HostConfig.PortBindings}}published{{else}}none{{end}}'
# shellcheck disable=SC2016
readonly BASIC_STATE_FORMAT='{{.State.Status}}|{{.State.Running}}|{{.State.Restarting}}'

stop() {
  printf 'STOP=%s\n' "$1" >&2
  exit 1
}

if (($# != 0)); then
  stop CALLER_ARGUMENTS_FORBIDDEN
fi
if ((EUID != 0)); then
  stop ROOT_REQUIRED
fi

PATH=$SAFE_PATH
LC_ALL=C
export PATH LC_ALL
unset CDPATH ENV BASH_ENV COMPOSE_FILE COMPOSE_PROJECT_NAME DOCKER_CONTEXT DOCKER_HOST DOCKER_CONFIG EVENTSALES_SECRET_DIR
cd / || stop FIXED_WORKING_DIRECTORY_UNAVAILABLE

require_trusted_directory() {
  local path=$1 metadata owner group mode mode_value
  [[ ! -L "$path" ]] || stop OLD_STAGE_DIRECTORY_SYMLINK
  [[ -d "$path" ]] || stop OLD_STAGE_DIRECTORY_MISSING
  metadata=$(/usr/bin/stat -c '%u:%g:%a' -- "$path" 2>/dev/null) || stop OLD_STAGE_DIRECTORY_METADATA_UNAVAILABLE
  IFS=: read -r owner group mode <<<"$metadata"
  [[ "$owner" == "$ROOT_UID" && "$group" == "$ROOT_GID" ]] || stop OLD_STAGE_DIRECTORY_NOT_ROOT_OWNED
  mode_value=$((8#$mode))
  (( (mode_value & 0022) == 0 )) || stop OLD_STAGE_DIRECTORY_WRITABLE
}

for directory in \
  '/root' \
  '/root/eventsales-prod' \
  '/root/eventsales-prod/staged' \
  "/root/eventsales-prod/staged/$OLD_SOURCE_SHA" \
  "$OLD_STAGE"; do
  require_trusted_directory "$directory"
done

old_stage_metadata=$(/usr/bin/stat -c '%u:%g:%a' -- "$OLD_STAGE" 2>/dev/null) || stop OLD_STAGE_METADATA_UNAVAILABLE
IFS=: read -r old_stage_owner old_stage_group old_stage_mode <<<"$old_stage_metadata"

[[ ! -L "$OLD_COMPOSE" ]] || stop OLD_COMPOSE_SYMLINK
[[ -f "$OLD_COMPOSE" ]] || stop OLD_COMPOSE_NOT_REGULAR
old_compose_metadata=$(/usr/bin/stat -c '%u:%g:%a' -- "$OLD_COMPOSE" 2>/dev/null) || stop OLD_COMPOSE_METADATA_UNAVAILABLE
IFS=: read -r old_compose_owner old_compose_group old_compose_mode <<<"$old_compose_metadata"
[[ "$old_compose_owner" == "$ROOT_UID" && "$old_compose_group" == "$ROOT_GID" ]] || stop OLD_COMPOSE_NOT_ROOT_OWNED
old_compose_mode_value=$((8#$old_compose_mode))
(( (old_compose_mode_value & 0222) == 0 )) || stop OLD_COMPOSE_WRITABLE
old_compose_digest=$(/usr/bin/sha256sum -- "$OLD_COMPOSE" 2>/dev/null) || stop OLD_COMPOSE_HASH_UNAVAILABLE
old_compose_sha256=${old_compose_digest%% *}
[[ "$old_compose_sha256" == "$EXPECTED_COMPOSE_SHA256" ]] || stop OLD_COMPOSE_HASH_MISMATCH

if [[ -e "$NEW_SOURCE_DIR" || -L "$NEW_SOURCE_DIR" || -e "$NEW_STAGE" || -L "$NEW_STAGE" ]]; then
  stop NEW_STAGE_ALREADY_EXISTS
fi

docker_fixed() {
  case "${1-}" in
    ps|inspect) ;;
    network|volume) [[ "${2-}" == inspect ]] || stop DOCKER_OPERATION_FORBIDDEN ;;
    *) stop DOCKER_OPERATION_FORBIDDEN ;;
  esac
  /usr/bin/env -i PATH="$SAFE_PATH" LC_ALL=C HOME=/nonexistent DOCKER_CONFIG=/nonexistent DOCKER_HOST="$DOCKER_SOCKET" docker "$@"
}

production_project_containers=$(docker_fixed ps -a --filter 'label=com.docker.compose.project=eventsales-prod' --format '{{.Names}}' 2>/dev/null) || stop PRODUCTION_CONTAINER_LIST_FAILED
production_named_containers=$(docker_fixed ps -a --filter 'name=eventsales-prod' --format '{{.Names}}' 2>/dev/null) || stop PRODUCTION_CONTAINER_LIST_FAILED
[[ "$production_project_containers" == "$POSTGRES_CONTAINER" && "$production_named_containers" == "$POSTGRES_CONTAINER" ]] || stop UNEXPECTED_PRODUCTION_CONTAINER

postgres_details=$(docker_fixed inspect --format "$POSTGRES_FORMAT" "$POSTGRES_CONTAINER" 2>/dev/null) || stop POSTGRES_CONTAINER_MISSING
[[ "$postgres_details" != *$'\n'* ]] || stop POSTGRES_METADATA_MISMATCH
IFS='|' read -r \
  postgres_status postgres_running postgres_restarting postgres_exit_code postgres_restart_count \
  postgres_oom postgres_image postgres_command postgres_mounts postgres_networks postgres_ports \
  <<<"$postgres_details"

[[ "$postgres_status" == exited && "$postgres_running" == false && "$postgres_restarting" == false && "$postgres_exit_code" == 1 && "$postgres_restart_count" == 24 && "$postgres_oom" == false ]] || stop POSTGRES_STATE_MISMATCH
[[ "$postgres_image" == "$POSTGRES_IMAGE" ]] || stop POSTGRES_IMAGE_MISMATCH
[[ "$postgres_command" == "$POSTGRES_COMMAND" ]] || stop POSTGRES_COMMAND_MISMATCH
[[ "$postgres_mounts" == "$POSTGRES_MOUNT" ]] || stop POSTGRES_VOLUME_ATTACHMENT_MISMATCH
[[ "$postgres_networks" == "$POSTGRES_NETWORK" ]] || stop POSTGRES_NETWORK_ATTACHMENT_MISMATCH
[[ "$postgres_ports" == none ]] || stop POSTGRES_PORTS_PUBLISHED

volume_metadata=$(docker_fixed volume inspect --format '{{.Name}}' "$POSTGRES_VOLUME" 2>/dev/null) || stop POSTGRES_VOLUME_MISSING
[[ "$volume_metadata" == "$POSTGRES_VOLUME" ]] || stop POSTGRES_VOLUME_MISMATCH

data_network_metadata=$(docker_fixed network inspect --format '{{.Name}}|{{.Driver}}|{{.Internal}}' "$DATA_NETWORK" 2>/dev/null) || stop PRODUCTION_NETWORK_MISMATCH
[[ "$data_network_metadata" == "$DATA_NETWORK|bridge|true" ]] || stop PRODUCTION_NETWORK_MISMATCH
edge_network_metadata=$(docker_fixed network inspect --format '{{.Name}}|{{.Driver}}|{{.Internal}}' "$EDGE_NETWORK" 2>/dev/null) || stop PRODUCTION_NETWORK_MISMATCH
[[ "$edge_network_metadata" == "$EDGE_NETWORK|bridge|false" ]] || stop PRODUCTION_NETWORK_MISMATCH

d0_containers=$(docker_fixed ps -a --filter 'label=com.docker.compose.project=eventsales-d0-proof' --format '{{.Names}}' 2>/dev/null) || stop D0_CONTAINER_LIST_FAILED
[[ -n "$d0_containers" ]] || stop D0_CONTAINER_COUNT_MISMATCH
mapfile -t d0_names <<<"$d0_containers"
[[ ${#d0_names[@]} -eq 3 ]] || stop D0_CONTAINER_COUNT_MISMATCH
d0_running_count=0
d0_restarting_count=0
for d0_name in "${d0_names[@]}"; do
  [[ "$d0_name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || stop D0_CONTAINER_NAME_INVALID
  d0_details=$(docker_fixed inspect --format "$BASIC_STATE_FORMAT" "$d0_name" 2>/dev/null) || stop D0_CONTAINER_INSPECT_FAILED
  [[ "$d0_details" != *$'\n'* ]] || stop D0_CONTAINER_METADATA_MISMATCH
  IFS='|' read -r d0_status d0_running d0_restarting <<<"$d0_details"
  [[ "$d0_status" == exited ]] || stop D0_NOT_ARCHIVED
  [[ "$d0_running" == false ]] || d0_running_count=$((d0_running_count + 1))
  [[ "$d0_restarting" == false ]] || d0_restarting_count=$((d0_restarting_count + 1))
done
((d0_running_count == 0 && d0_restarting_count == 0)) || stop D0_NOT_ARCHIVED

printf 'AUDIT_VERSION=1\n'
printf 'OLD_STAGE_EXISTS=YES\n'
printf 'OLD_STAGE_OWNER=%s\n' "$old_stage_owner"
printf 'OLD_STAGE_GROUP=%s\n' "$old_stage_group"
printf 'OLD_STAGE_MODE=%s\n' "$old_stage_mode"
printf 'OLD_STAGE_SYMLINK=NO\n'
printf 'OLD_STAGE_COMPOSE_SHA256=%s\n' "$old_compose_sha256"
printf 'OLD_STAGE_COMPOSE_MATCH=YES\n'
printf 'NEW_STAGE_EXISTS=NO\n'
printf 'POSTGRES_CONTAINER_EXISTS=YES\n'
printf 'POSTGRES_STATUS=%s\n' "$postgres_status"
printf 'POSTGRES_RUNNING=%s\n' "$postgres_running"
printf 'POSTGRES_RESTARTING=%s\n' "$postgres_restarting"
printf 'POSTGRES_EXIT_CODE=%s\n' "$postgres_exit_code"
printf 'POSTGRES_RESTART_COUNT=%s\n' "$postgres_restart_count"
printf 'POSTGRES_OOM_KILLED=%s\n' "$postgres_oom"
printf 'POSTGRES_IMAGE_MATCH=YES\n'
printf 'POSTGRES_COMMAND_CLASS=HISTORICAL_BAD_COMMAND\n'
printf 'POSTGRES_VOLUME_ATTACHMENT_MATCH=YES\n'
printf 'POSTGRES_NETWORK_ATTACHMENT_MATCH=YES\n'
printf 'POSTGRES_PORTS_PUBLISHED=NO\n'
printf 'POSTGRES_VOLUME_EXISTS=YES\n'
printf 'DATA_NETWORK_EXISTS=YES\n'
printf 'DATA_NETWORK_DRIVER=bridge\n'
printf 'DATA_NETWORK_INTERNAL=true\n'
printf 'EDGE_NETWORK_EXISTS=YES\n'
printf 'EDGE_NETWORK_DRIVER=bridge\n'
printf 'EDGE_NETWORK_INTERNAL=false\n'
printf 'PRODUCTION_CONTAINER_COUNT=1\n'
printf 'PRODUCTION_CONTAINERS=%s\n' "$POSTGRES_CONTAINER"
printf 'PGBOUNCER_STARTED=NO\n'
printf 'REDIS_STARTED=NO\n'
printf 'APP_STARTED=NO\n'
printf 'D0_CONTAINER_COUNT=3\n'
printf 'D0_RUNNING_COUNT=%s\n' "$d0_running_count"
printf 'D0_RESTARTING_COUNT=%s\n' "$d0_restarting_count"
printf 'D0_STATE=ARCHIVED_STOPPED\n'
printf 'AUDIT_RESULT=PASS\n'
